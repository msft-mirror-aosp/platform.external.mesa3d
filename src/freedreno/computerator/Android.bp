package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["external_mesa3d_license"],
}

cc_defaults {
    name: "computerator_cpp_args",
    vendor: true,
    cppflags: select((arch(), os()), {
        ("arm64", "android"): [
            "-Wno-array-bounds",
            "-Wno-c++11-narrowing",
            "-Wno-narrowing",
            "-Wno-sign-compare",
        ],
        (default, default): [],
    }),
}
